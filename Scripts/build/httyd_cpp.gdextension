[configuration]
entry_symbol = "gdextension_init"
compatibility_minimum = 4.5

[libraries]
windows.debug.x86_64   = "res://Scripts/build/httyd_cpp.dll"
windows.release.x86_64 = "res://Scripts/build/httyd_cpp.dll"

[dependencies]
windows.debug.x86_64 = {
	"res://Scripts/build/libstdc++-6.dll" : "",
	"res://Scripts/build/libgcc_s_seh-1.dll" : "",
	"res://Scripts/build/libwinpthread-1.dll" : ""
}
windows.release.x86_64 = {
	"res://Scripts/build/libstdc++-6.dll" : "",
	"res://Scripts/build/libgcc_s_seh-1.dll" : "",
	"res://Scripts/build/libwinpthread-1.dll" : ""
}
