        "${workspaceFolder}/Scripts/**",
        "${workspaceFolder}/Addons/godot-cpp/include",
        "${workspaceFolder}/Addons/godot-cpp/gen/include",
        "${workspaceFolder}/Addons/godot-cpp/gdextension"
      ],
      "compilerPath": "D:/Background_Programs/MinGW/bin/g++.exe",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "windows-gcc-x64",
