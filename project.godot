[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="HTTYD"
run/main_scene="uid://clo2gf4m2p2an"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout=""

[autoload]

XRToolsUserSettings="*uid://bqgb8i74tm0t"
XRToolsRumbleManager="*uid://by853dk86g1qw"
SettingsGlobal="*uid://ddywr4k6c8043"
SimpleGrass="*uid://bfq0snth8sj3h"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/incompatible_ternary=0
gdscript/warnings/integer_division=0

[display]

window/size/always_on_top=true
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0
window/show_image=false
window/quality/msaa_3d=1

[dotnet]

project/assembly_name="HTTYD"

[editor]

naming/scene_name_casing=1
naming/script_name_casing=1

[editor_plugins]

enabled=PackedStringArray("res://Addons/SunshineClouds2/plugin.cfg", "res://Addons/godot-xr-tools/plugin.cfg", "res://Addons/sky_3d/plugin.cfg", "res://addons/brackeys_particle_controls/plugin.cfg", "res://addons/ocean_system/plugin.cfg", "res://addons/simplegrasstextured/plugin.cfg")

