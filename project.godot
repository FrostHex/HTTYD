; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="HTTYD"
run/main_scene="uid://clo2gf4m2p2an"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout=""

[autoload]

XRToolsUserSettings="*uid://bqgb8i74tm0t"
XRToolsRumbleManager="*uid://by853dk86g1qw"
SettingsGlobal="*uid://ddywr4k6c8043"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/incompatible_ternary=0
gdscript/warnings/integer_division=0

[display]

window/size/always_on_top=true
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0
window/show_image=false
window/quality/msaa_3d=1

[dotnet]

project/assembly_name="HTTYD"

[editor]

naming/scene_name_casing=1
naming/script_name_casing=1

[editor_plugins]

enabled=PackedStringArray("res://Addons/SunshineClouds2/plugin.cfg", "res://Addons/godot-xr-tools/plugin.cfg", "res://Addons/sky_3d/plugin.cfg", "res://addons/ocean_system/plugin.cfg")

[file_customization]

folder_colors={
"res://Addons/": "gray",
"res://Dragons/": "blue",
"res://Environment/": "teal",
"res://Media/": "green",
"res://Saves/": "orange",
"res://Scenes/": "red",
"res://Scripts/": "purple",
"res://Scripts/build/": "gray"
}

[filesystem]

import/blender/enabled=false

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/default_font_generate_mipmaps=true

[input]

toggle_fullscreen={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"command_or_control_autoremap":true,"alt_pressed":false,"shift_pressed":false,"pressed":false,"keycode":0,"physical_keycode":70,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
save_state={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":16,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":67,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
load_state={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":16,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":86,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[layer_names]

3d_physics/layer_1="player"
3d_physics/layer_2="dragon"
3d_physics/layer_3="rocks"
3d_physics/layer_4="cheat_sheet"

[network]

limits/debugger/max_chars_per_second=2147483647

[physics]

3d/default_linear_damp=0.0
3d/default_angular_damp=0.0

[rendering]

textures/canvas_textures/default_texture_filter=2
lights_and_shadows/use_physical_light_units=true
textures/default_filters/use_nearest_mipmap_filter=true
anti_aliasing/quality/msaa_2d=3

[xr]

openxr/default_action_map="res://Addons/godot-xr-tools/openxr_action_map.tres"
openxr/foveation_level=3
openxr/foveation_dynamic=true
